# Build/image
OPENCLAW_IMAGE=openclaw:local

# Gateway network
OPENCLAW_GATEWAY_BIND=0.0.0.0
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_GATEWAY_MODE=lan
OPENCLAW_TZ=UTC

# Reuse local CLI auth inside Docker.
# Run scripts/sync-cli-auth-env.sh after copying this file to .env to auto-fill
# readable local copies for the current machine. Mounts are read-only in compose.
CODEX_CONFIG_DIR=
CLAUDE_CONFIG_DIR=

# Required
OPENCLAW_GATEWAY_TOKEN=replace-with-random-token

# Optional Claude auth
CLAUDE_AI_SESSION_KEY=
CLAUDE_WEB_SESSION_KEY=
CLAUDE_WEB_COOKIE=

# Optional flags
OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=
